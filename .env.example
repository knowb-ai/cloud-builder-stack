# Cloud Builder Stack environment template
# Copy this file to .env and fill only the values you need.
# Never commit .env or real credentials.

###############################################################################
# Project
###############################################################################

APP_ENV=development
APP_NAME=cloud-builder-stack
APP_BASE_URL=http://localhost:3000
PUBLIC_DEMO_MODE=true
LOG_LEVEL=info

###############################################################################
# Tavily
# Docs: https://docs.tavily.com/
###############################################################################

TAVILY_API_KEY=tvly-your-api-key
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5

###############################################################################
# n8n
# Docs: https://docs.n8n.io/hosting/configuration/environment-variables/
###############################################################################

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret
N8N_USER_MANAGEMENT_DISABLED=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=true
N8N_TEMPLATES_ENABLED=true

# Use PostgreSQL for shared or persistent workshop environments.
# For local throwaway demos, n8n defaults to SQLite if DB_TYPE is not set.
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=replace-with-a-database-password

###############################################################################
# Gradium
# Docs/API entry point: https://gradium.ai/
###############################################################################

GRADIUM_API_KEY=your-gradium-api-key
GRADIUM_BASE_URL=https://api.gradium.ai
GRADIUM_DEFAULT_VOICE_ID=your-voice-id
GRADIUM_DEFAULT_LANGUAGE=en

###############################################################################
# Base44
# Docs: https://docs.base44.com/
###############################################################################

BASE44_WORKSPACE_ID=your-base44-workspace-id
BASE44_APP_ID=your-base44-app-id
BASE44_APP_URL=https://app.base44.com
# Base44 project secrets are usually managed with the Base44 CLI:
# base44 secrets set --env-file .env
# Keep third-party service keys in backend functions or managed connectors,
# not in browser-exposed frontend variables.
BASE44_PROJECT_ENV=dev

###############################################################################
# Nebius AI Cloud
# Docs: https://docs.nebius.com/
###############################################################################

NEBIUS_PROFILE=default
NEBIUS_PROJECT_ID=your-nebius-project-id
NEBIUS_REGION=eu-north1
NEBIUS_SERVICE_ACCOUNT_ID=your-service-account-id
NEBIUS_IAM_TOKEN=your-nebius-iam-token
NEBIUS_OBJECT_STORAGE_ENDPOINT=https://storage.eu-north1.nebius.cloud
NEBIUS_OBJECT_STORAGE_BUCKET=your-workshop-bucket
NEBIUS_ACCESS_KEY_ID=your-object-storage-access-key
NEBIUS_SECRET_ACCESS_KEY=your-object-storage-secret-key

###############################################################################
# Optional shared AI provider settings for demos
###############################################################################

OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key
GOOGLE_API_KEY=your-google-api-key

###############################################################################
# Optional workshop integrations
###############################################################################

SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
DISCORD_BOT_TOKEN=your-discord-bot-token
GITHUB_TOKEN=ghp-your-github-token

###############################################################################
# Safety controls for public workshops and livestreams
###############################################################################

ALLOW_PUBLIC_SIGNUPS=false
ALLOW_EXTERNAL_WEBHOOKS=false
MAX_REQUESTS_PER_MINUTE=60
ENABLE_COST_GUARDRAILS=true
MONTHLY_SPEND_LIMIT_USD=50
